{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rtx-fg-community",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-03-17",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "d1_databases": [{"binding": "DB", "database_name": "rtx-fg-community", "database_id": "REPLACE_WITH_D1_ID", "migrations_dir": "migrations"}],
  "ratelimits": [{"name": "READ_LIMITER", "namespace_id": "43001", "simple": {"limit": 120, "period": 60}}],
  "triggers": {"crons": ["*/10 * * * *"]},
  "observability": {"enabled": false},
  "vars": {"PUBLIC_HOST": "YOUR_WORKER.workers.dev", "TURNSTILE_SITE_KEY": "YOUR_PUBLIC_SITE_KEY", "MODERATOR_KEYS": "{}"}
}
